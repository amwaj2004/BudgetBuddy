<Window x:Class="BudgetBuddy.ViewSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BudgetBuddy"
        mc:Ignorable="d"
        Title="View Summary"
        Height="500" Width="650"
        Background="#fff3eb"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="View Summary"
                   FontFamily="Palatino Linotype"
                   FontSize="22"
                   FontWeight="Light"
                   Foreground="#5c3458"
                   Margin="0,0,0,6"/>

        <!-- Subtitle -->
        <TextBlock Grid.Row="1"
                   Text="Select a month from the list to view its summary"
                   FontSize="12"
                   Foreground="#b09aab"
                   Margin="0,0,0,16"/>

        <!-- File list + content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <ListBox x:Name="FileList"
                     Grid.Column="0"
                     BorderBrush="#EDD9CC"
                     BorderThickness="1"
                     Background="White"
                     FontSize="12"
                     Foreground="#5c3458"
                     SelectionChanged="FileList_SelectionChanged"/>

            <!-- File content -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="FileContent"
                         FontSize="12"
                         Foreground="#333"
                         Background="White"
                         BorderBrush="#EDD9CC"
                         BorderThickness="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Padding="10"
                         FontFamily="Courier New"/>
            </ScrollViewer>
        </Grid>

        <!-- Close button -->
        <Button Grid.Row="3"
                Content="Close"
                FontSize="13"
                Padding="0,10"
                Background="#756e91"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,16,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>