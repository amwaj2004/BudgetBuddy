<Window x:Class="BudgetBuddy.AddMoneyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BudgetBuddy"
        mc:Ignorable="d"
        Title="Add Money to Goal"
        Height="250" Width="400"
        Background="#fff3eb"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30">

            <TextBlock Text="Add Money to Goal"
                       FontFamily="Palatino Linotype"
                       FontSize="22"
                       FontWeight="Light"
                       Foreground="#5c3458"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="AvailableBalanceLabel"
                       FontSize="12"
                       Foreground="#b09aab"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Amount ($)"
                       FontSize="12"
                       Foreground="#b09aab"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="AmountInput"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#EDD9CC"
                     BorderThickness="1"
                     Background="White"
                     Foreground="#333"
                     Margin="0,0,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        FontSize="13"
                        Padding="0,10"
                        Background="White"
                        Foreground="#756e91"
                        BorderBrush="#EDD9CC"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Cancel_Click"/>

                <Button Grid.Column="2"
                        Content="Add Money"
                        FontSize="13"
                        Padding="0,10"
                        Background="#756e91"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="AddMoney_Click"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>