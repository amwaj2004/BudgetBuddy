<Window x:Class="BudgetBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BudgetBuddy"
        mc:Ignorable="d"
        Title="BudgetBuddy" Height="750" Width="1100"
        Background="#fff3eb"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#EDD9CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#5c3458"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#fcf0fc"/>
            <Setter Property="Foreground"      Value="#333"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="BorderBrush"     Value="#EDD9CC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#fff3eb"
                BorderBrush="#edd9cc"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="30"
                             Height="30"
                             Fill="#e8c9d9"
                             Margin="0,0,10,0"/>
                    <TextBlock Text="BudgetBuddy"
                               FontSize="20"
                               FontFamily="Georgia"
                               FontWeight="Medium"
                               Foreground="#333"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Summary Button -->
                <Button Grid.Column="1"
                        Content="View Summary"
                        Width="150"
                        FontSize="14"
                        Cursor="Hand"
                        Foreground="White"
                        Background="#756e91"
                        HorizontalAlignment="Right"
                        Click="ViewSummary_Click"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="30">

                <!-- Greeting + Month Picker -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="This Month's Budget"
                               FontSize="13"
                               Foreground="#b09aab"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="MonthYearLabel"
                               Text=""
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12"
                               FontWeight="Light"
                               FontSize="26"
                               FontFamily="Palatino Linotype"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="MonthPicker"
                                  FontSize="13"
                                  Padding="8,6"
                                  BorderBrush="#EDD9CC"
                                  Width="140"
                                  Margin="0,0,10,0">
                            <ComboBoxItem Content="January"/>
                            <ComboBoxItem Content="February"/>
                            <ComboBoxItem Content="March"/>
                            <ComboBoxItem Content="April"/>
                            <ComboBoxItem Content="May"/>
                            <ComboBoxItem Content="June"/>
                            <ComboBoxItem Content="July"/>
                            <ComboBoxItem Content="August"/>
                            <ComboBoxItem Content="September"/>
                            <ComboBoxItem Content="October"/>
                            <ComboBoxItem Content="November"/>
                            <ComboBoxItem Content="December"/>
                        </ComboBox>
                        <TextBox x:Name="YearPicker"
                                 Text="2025"
                                 FontSize="13"
                                 Padding="8,6"
                                 BorderBrush="#EDD9CC"
                                 Width="80"
                                 Margin="0,0,10,0"/>
                        <Button Content="Set Month"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,5"
                                Click="pickMonth_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Stat Cards -->
                <UniformGrid Columns="3" Margin="0,0,0,12">

                    <!-- Balance -->
                    <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Balance"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="BalanceLabel"
                                       FontFamily="Palatino Linotype"
                                       FontWeight="SemiBold"
                                       FontSize="35"
                                       Foreground="#3D2534"/>
                            <TextBlock x:Name="BalanceChangeLabel"
                                       FontSize="14"
                                       Foreground="#6BA580"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Income -->
                    <Border Style="{StaticResource Card}" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Income"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="IncomeDisplay"
                                       Text="Enter Income"
                                       FontSize="35"
                                       FontFamily="Palatino Linotype"
                                       Foreground="#0F0A99"/>
                            <TextBox x:Name="IncomeInput"
                                     Text="0.00"
                                     FontSize="20"
                                     FontFamily="Palatino Linotype"
                                     Foreground="#b09aab"/>
                            <Button Content="Confirm Income"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right"
                                    Padding="14,5"
                                    Click="AddIncome_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Spent -->
                    <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Spent"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="SpentLabel"
                                       FontFamily="Palatino Linotype"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#c97070"/>
                            <TextBlock x:Name="SpentSubLabel"
                                       FontSize="11"
                                       Foreground="#b09aab"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Savings Card -->
                <!-- Savings Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Total Savings"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="SavingsLabel"
                   FontFamily="Palatino Linotype"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#6BA580"
                   Text="$0.00"/>
                        <TextBlock x:Name="SavingsSubLabel"
                   FontSize="11"
                   Foreground="#b09aab"
                   Margin="0,4,0,12"
                   Text="accumulated savings"/>

                        <!-- Add and Withdraw buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Add to Savings"
                    FontSize="12"
                    Padding="12,6"
                    Background="#6BA580"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0"
                    Click="AddToSavings_Click"/>
                            <Button Content="- Withdraw"
                    FontSize="12"
                    Padding="12,6"
                    Background="#C97070"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="WithdrawSavings_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Budget Banner (empty for now) -->
                <Border Margin="0,0,0,12">
                </Border>

                <!-- Expenses + Breakdown side by side -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Expenses Card -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Monthly Expenses"
                                           Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                <Button Content="Add Expense"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        Padding="14,5"
                                        Click="AddExpense_Click"/>
                            </Grid>
                            <StackPanel x:Name="EntriesPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- Spending Breakdown Card -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Spending Breakdown"
                                       Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,0,12"/>
                            <StackPanel x:Name="BreakdownPanel"/>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Total spent"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#333"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TotalSpentText"
                                           FontSize="20"
                                           FontWeight="Medium"
                                           Foreground="#333"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Savings Goals Card (full width) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Savings Goals"
                                       Style="{StaticResource SectionTitle}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Button Content="+ Add Goal"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right"
                                    Padding="14,5"
                                    Click="AddGoal_Click"/>
                        </Grid>
                        <StackPanel x:Name="GoalsPanel"/>
                    </StackPanel>
                </Border>

                <!-- Complete This Month Button -->
                <Button Content="Complete This Month"
                        FontSize="14"
                        Padding="0,12"
                        Background="#756e91"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,16"
                        Click="NextMonth_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>