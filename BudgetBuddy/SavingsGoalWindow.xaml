<Window x:Class="BudgetBuddy.SavingsGoalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BudgetBuddy"
        mc:Ignorable="d"
        Title="Add Savings Goal"
        Height="380" Width="400"
        Background="#fff3eb"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30">

            <!-- Title -->
            <TextBlock Text="Add Savings Goal"
                       FontFamily="Palatino Linotype"
                       FontSize="22"
                       FontWeight="Light"
                       Foreground="#5c3458"
                       Margin="0,0,0,24"/>

            <!-- Goal Name -->
            <TextBlock Text="Goal Name"
                       FontSize="12"
                       Foreground="#b09aab"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="GoalNameInput"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#EDD9CC"
                     BorderThickness="1"
                     Background="White"
                     Foreground="#333"
                     Margin="0,0,0,16"/>

            <!-- Target Amount -->
            <TextBlock Text="Target Amount ($)"
                       FontSize="12"
                       Foreground="#b09aab"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="TargetAmountInput"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#EDD9CC"
                     BorderThickness="1"
                     Background="White"
                     Foreground="#333"
                     Margin="0,0,0,16"/>

            <!-- Amount Saved So Far -->
            <TextBlock x:Name="SavedAmountLabel"
                       Text="Amount Saved So Far ($) — optional"
                       FontSize="12"
                       Foreground="#b09aab"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="SavedAmountInput"
                     Text="0"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#EDD9CC"
                     BorderThickness="1"
                     Background="White"
                     Foreground="#333"
                     Margin="0,0,0,24"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        FontSize="13"
                        Padding="0,10"
                        Background="White"
                        Foreground="#756e91"
                        BorderBrush="#EDD9CC"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Cancel_Click"/>

                <Button Grid.Column="2"
                        Content="Save Goal"
                        FontSize="13"
                        Padding="0,10"
                        Background="#756e91"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SaveGoal_Click"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>